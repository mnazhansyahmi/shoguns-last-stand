[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/ui/debug_hud.gd" id="1_hud"]

[node name="DebugHud" type="CanvasLayer"]
script = ExtResource("1_hud")

[node name="Margin" type="MarginContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 32
theme_override_constants/margin_bottom = 24

[node name="Stats" type="VBoxContainer" parent="Margin"]
layout_mode = 2
size_flags_horizontal = 0
size_flags_vertical = 0
mouse_filter = 2

[node name="PlayerHealthLabel" type="Label" parent="Margin/Stats"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 8
theme_override_font_sizes/font_size = 36
text = "Samurai HP: 200 / 200"

[node name="GateHealthLabel" type="Label" parent="Margin/Stats"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 8
theme_override_font_sizes/font_size = 36
text = "Gate HP: 1000 / 1000"

[node name="EnergyLabel" type="Label" parent="Margin/Stats"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.55, 0.9, 1, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 8
theme_override_font_sizes/font_size = 36
text = "Spirit Energy: 50 / 150"

[node name="CooldownLabel" type="Label" parent="Margin/Stats"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.9, 1, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 6
theme_override_font_sizes/font_size = 26
text = "Dash: ready   Heavy: ready   Spirit Slash: ready"

[node name="WaveBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
size_flags_horizontal = 4
size_flags_vertical = 0
mouse_filter = 2

[node name="WaveLabel" type="Label" parent="Margin/WaveBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.96, 0.87, 0.62, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 8
theme_override_font_sizes/font_size = 40
text = "Wave 1 / 3"
horizontal_alignment = 1

[node name="RemainingLabel" type="Label" parent="Margin/WaveBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 6
theme_override_font_sizes/font_size = 28
text = "Enemies remaining: 0"
horizontal_alignment = 1

[node name="CenterBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
size_flags_horizontal = 4
size_flags_vertical = 4
mouse_filter = 2

[node name="BannerLabel" type="Label" parent="Margin/CenterBox"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_colors/font_color = Color(0.96, 0.87, 0.62, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 14
theme_override_font_sizes/font_size = 88
text = "Wave 1"
horizontal_alignment = 1

[node name="StatusLabel" type="Label" parent="Margin/CenterBox"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.3, 0.25, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 14
theme_override_font_sizes/font_size = 96
text = "DEFEAT"
horizontal_alignment = 1

[node name="BottomBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
size_flags_vertical = 8
mouse_filter = 2

[node name="MessageLabel" type="Label" parent="Margin/BottomBox"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.75, 0.4, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 6
theme_override_font_sizes/font_size = 28
text = "Not enough Spirit Energy"
horizontal_alignment = 1

[node name="SummonLabel" type="Label" parent="Margin/BottomBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.95, 1, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 8
theme_override_font_sizes/font_size = 32
text = "[1] Ashigaru (30)    [2] Yumi Archer (45)    Allies 0 / 6"
horizontal_alignment = 1

[node name="HintLabel" type="Label" parent="Margin/BottomBox"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 0.75)
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 6
theme_override_font_sizes/font_size = 24
text = "A/D move   J attack (x3 combo)   K heavy   L dash   U spirit slash   1/2 summon   Esc menu"

[node name="DebugHintLabel" type="Label" parent="Margin/BottomBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.85, 0.5, 0.75)
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 6
theme_override_font_sizes/font_size = 22
text = "DEBUG BUILD: F1 spawn Hollow Soldier   F2 spawn Oni Brute (not counted in waves)"
