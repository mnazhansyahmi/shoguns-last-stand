[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/enemies/enemy.gd" id="1_enemy"]
[ext_resource type="Script" path="res://scripts/visuals/unit_visual.gd" id="2_visual"]
[ext_resource type="Script" path="res://scripts/visuals/ink_figure.gd" id="20_figure"]
[ext_resource type="Script" path="res://scripts/components/health_component.gd" id="3_health"]
[ext_resource type="Script" path="res://scripts/components/hurtbox_component.gd" id="4_hurtbox"]
[ext_resource type="Script" path="res://scripts/components/hitbox_component.gd" id="5_hitbox"]
[ext_resource type="Script" path="res://scripts/components/world_health_bar.gd" id="6_bar"]

[node name="Enemy" type="CharacterBody2D"]
collision_layer = 8
collision_mask = 1
script = ExtResource("1_enemy")

[node name="CollisionShape2D" type="CollisionShape2D" parent="."]

[node name="Visual" type="Node2D" parent="."]
script = ExtResource("2_visual")
figure_kind = 3
figure_height = 110.0

[node name="Figure" type="Node2D" parent="Visual"]
script = ExtResource("20_figure")
kind = 3
height = 110.0

[node name="HealthComponent" type="Node" parent="."]
script = ExtResource("3_health")

[node name="Hurtbox" type="Area2D" parent="." node_paths=PackedStringArray("health_component")]
script = ExtResource("4_hurtbox")
faction = 1
health_component = NodePath("../HealthComponent")

[node name="CollisionShape2D" type="CollisionShape2D" parent="Hurtbox"]

[node name="Hitbox" type="Area2D" parent="."]
script = ExtResource("5_hitbox")
faction = 1

[node name="CollisionShape2D" type="CollisionShape2D" parent="Hitbox"]

[node name="HealthBar" type="Node2D" parent="."]
script = ExtResource("6_bar")
hide_until_damaged = true
stagger = true
