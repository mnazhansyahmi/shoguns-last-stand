[gd_resource type="Resource" script_class="WaveData" format=3]

[ext_resource type="Script" path="res://scripts/resources/wave_data.gd" id="1_wave"]
[ext_resource type="Script" path="res://scripts/resources/wave_entry.gd" id="2_entry"]
[ext_resource type="Resource" path="res://data/enemies/hollow_soldier.tres" id="3_hollow"]
[ext_resource type="Resource" path="res://data/enemies/oni_brute.tres" id="4_oni"]

[sub_resource type="Resource" id="Resource_hollow"]
script = ExtResource("2_entry")
enemy = ExtResource("3_hollow")
count = 10
start_delay = 0.0
spawn_interval = 0.6

[sub_resource type="Resource" id="Resource_oni"]
script = ExtResource("2_entry")
enemy = ExtResource("4_oni")
count = 1
start_delay = 1.0
spawn_interval = 0.0

[resource]
script = ExtResource("1_wave")
entries = Array[ExtResource("2_entry")]([SubResource("Resource_hollow"), SubResource("Resource_oni")])
