[resource]
script = ExtResource("1_stage")
stage_id = "stage_7"
display_name = "Ashen Fields"
waves = Array[ExtResource("2_wave")]([ExtResource("w1"), ExtResource("w2"), ExtResource("w3"), ExtResource("w4"), ExtResource("w5")])
first_wave_delay = 4.0
break_duration = 6.0
clear_gold_bonus = 1120
clear_xp_bonus = 190
defeat_reward_ratio = 0.5
replay_gold_multiplier = 0.5
atmosphere = ExtResource("atmo")
description = "Rice fields under falling ash. Spectral Archers shoot out of the smoke at your allies: cut them down first."
tagline = "Arrows from the smoke"
