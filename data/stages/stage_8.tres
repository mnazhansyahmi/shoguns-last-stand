[resource]
script = ExtResource("1_stage")
stage_id = "stage_8"
display_name = "Burning Market"
waves = Array[ExtResource("2_wave")]([ExtResource("w1"), ExtResource("w2"), ExtResource("w3"), ExtResource("w4"), ExtResource("w5")])
first_wave_delay = 4.0
break_duration = 6.5
clear_gold_bonus = 1240
clear_xp_bonus = 210
defeat_reward_ratio = 0.5
replay_gold_multiplier = 0.5
atmosphere = ExtResource("atmo")
description = "The market street is ablaze. Shield Bearers lock their shields in front: break them with heavy blows or strike from behind."
tagline = "Shields in the market"
